body {
  font-family: Arial;
  margin: 0;
  background: #fff5e6;
}

header {
  background: red;
  color: white;
  padding: 15px;
  text-align: center;
}

nav a {
  color: white;
  margin: 10px;
  text-decoration: none;
}

.hero {
  text-align: center;
  padding: 50px;
  background: orange;
  color: white;
}

.menu {
  padding: 20px;
  text-align: center;
}

.menu div {
  background: white;
  margin: 10px;
  padding: 10px;
  border-radius: 8px;
}

.contact {
  text-align: center;
  padding: 20px;
}

footer {
  background: red;
  color: white;
  text-align: center;
  padding: 10px;
}